# Server-only configuration
# Complete canonical Paradox URL from `parad init ... --print-database-url`; keep it secret.
DATABASE_URL=parad://...
JWT_SECRET=
NEXUSS_AUTH_URL=https://nexuss-auth.vercel.app
NEXUSS_AUTH_PROJECT_ID=c-nine-study
NEXUSS_AUTH_REDIRECT_URI=https://c-nine-gamma.vercel.app/auth/callback
CRON_SECRET=

# Public browser routing configuration; never place secrets under VITE_.
VITE_NEXUSS_AUTH_URL=https://nexuss-auth.vercel.app
VITE_NEXUSS_AUTH_PROJECT_ID=c-nine-study
VITE_NEXUSS_AUTH_REDIRECT_URI=https://c-nine-gamma.vercel.app/auth/callback
